# ─── Backend env vars ─────────────────────────────────────────────────────────
# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017

# MongoDB database name
DB_NAME=resumecheck

# JWT signing secret — MUST be a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string

# Your deployed frontend URL (used to restrict CORS in production).
# For local dev leave blank or set to http://localhost:5173
# For cloud set to e.g. https://resume-analyzer.vercel.app
FRONTEND_URL=http://localhost:5173
